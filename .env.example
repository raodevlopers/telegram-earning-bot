NODE_ENV=development
PORT=3000
WEBHOOK_BASE_URL=https://your-service.onrender.com
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret
BOT_TOKEN=replace-with-bot-token
BOT_USERNAME=YourBotUsername

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

ADMIN_PASSWORD_HASH=$2b$12$replace_with_bcrypt_hash
SESSION_SECRET=replace-with-long-random-secret
ADMIN_ORIGIN=https://hybrid-engineer.web.app

TASK_REWARD_PAISE=1000
REFERRAL_REWARD_PAISE=500
MIN_WITHDRAWAL_PAISE=3000
TASK_VERIFY_COOLDOWN_SECONDS=15
